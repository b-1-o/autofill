{
  "manifest_version": 3,
  "name": "b1o Autofill",
  "version": "0.2.0",
  "description": "Fast, review-first autofill for job applications.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "b1o Autofill",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["content/content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}